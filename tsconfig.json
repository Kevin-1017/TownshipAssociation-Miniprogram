{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    // mock 层直接 import *.json,必须开这个否则 vue-tsc 报 Cannot find module
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    // @tdesign/uniapp/global 提供 t-* 组件在模板中的智能提示
    "types": ["@dcloudio/types", "@tdesign/uniapp/global"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
