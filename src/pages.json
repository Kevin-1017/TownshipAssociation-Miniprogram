{
	// pages 数组中第一项表示应用启动页,参考:https://uniapp.dcloud.io/collocation/pages
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "汕头乡会"
			}
		}
	],
	// easycom:TDesign 官方推荐的按需自动导入方式。
	// 配置后模板里直接写 <t-button> 即可,无需 import;不要改成 app.use() 全量导入,
	// 官方明确说明全量导入在小程序下有兼容性问题。
	"easycom": {
		"custom": {
			"^t-(.*)": "@tdesign/uniapp/$1/$1.vue"
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "汕头乡会",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F5F5F5"
	}
}
