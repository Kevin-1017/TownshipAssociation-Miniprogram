{
	// pages 数组中第一项是启动页。参考:https://uniapp.dcloud.io/collocation/pages
	"pages": [
		{
			"path": "pages/index/index",
			"style": { "navigationBarTitleText": "广工潮阳潮南校友会" }
		},
		{
			// 地图页要沉浸式,所以隐藏原生导航栏;顶部安全区由页面自己处理。
			// ★ 刻意不进 tabBar:tab 页创建后常驻不卸载,map 是原生组件,
			//   切到其他 tab 时原生层不会跟着隐藏,会在别的页面底部漏出来。
			//   作为普通页面用 navigateTo 打开,返回即销毁,泄漏随之消失。
			"path": "pages/map/index",
			"style": { "navigationStyle": "custom" }
		},
		{
			"path": "pages/member/detail",
			"style": { "navigationBarTitleText": "成员资料" }
		},
		{
			"path": "pages/community/index",
			"style": { "navigationBarTitleText": "社区" }
		},
		{
			"path": "pages/community/food",
			"style": { "navigationBarTitleText": "美食基地" }
		},
		{
			"path": "pages/community/campus",
			"style": { "navigationBarTitleText": "校园广场" }
		},
		{
			"path": "pages/community/publish-food",
			"style": { "navigationBarTitleText": "发布美食动态" }
		},
		{
			"path": "pages/community/publish-campus",
			"style": { "navigationBarTitleText": "发布校园动态" }
		},
		{
			"path": "pages/community/detail",
			"style": { "navigationBarTitleText": "动态详情" }
		},
		{
			"path": "pages/event/list",
			"style": { "navigationBarTitleText": "乡会事件" }
		},
		{
			"path": "pages/event/detail",
			"style": { "navigationBarTitleText": "事件详情" }
		},
		{
			"path": "pages/notice/detail",
			"style": { "navigationBarTitleText": "公告" }
		},
		{
			"path": "pages/foundation/index",
			"style": { "navigationBarTitleText": "校友基金会" }
		},
		{
			"path": "pages/mine/profile",
			"style": { "navigationBarTitleText": "我的资料" }
		},
		{
			"path": "pages/mine/privacy",
			"style": { "navigationBarTitleText": "隐私政策" }
		},
		{
			"path": "pages/mine/agreement",
			"style": { "navigationBarTitleText": "用户协议" }
		},
		{
			"path": "pages/mine/index",
			"style": { "navigationBarTitleText": "我的" }
		}
	],
	// easycom:TDesign 官方推荐的按需自动导入。模板里直接写 <t-button> 即可。
	// 不要改成 main.ts 里 app.use() 全量导入 —— 官方明确说明小程序下会有兼容问题。
	"easycom": {
		"custom": {
			"^t-(.*)": "@tdesign/uniapp/$1/$1.vue"
		}
	},
	// switchTab 的硬性前提:tab 页必须登记在这里。原生 tab bar 启动时会闪一下,
	// 四个 tab 页在 onShow 里统一 hideTabBar() 藏掉,只保留页面自绘的悬浮胶囊。
	// 不放图标:这个 bar 从不会真正展示,text 只为满足校验。
	"tabBar": {
		"color": "#999999",
		"selectedColor": "#0052d9",
		"backgroundColor": "#ffffff",
		"list": [
			{ "pagePath": "pages/index/index", "text": "首页" },
			{ "pagePath": "pages/community/index", "text": "社区" },
			{ "pagePath": "pages/event/list", "text": "事件" },
			{ "pagePath": "pages/mine/index", "text": "我的" }
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "广工潮阳潮南校友会",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F5F5F5"
	}
}
