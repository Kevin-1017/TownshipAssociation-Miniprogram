# 开发期配置 —— 此文件不含密钥,提交进仓库
# 个人本地覆盖请写 .env.development.local(已被 .gitignore 忽略)

# 走本地 mock,不发真实请求。后端 tsa-api 就绪后改成 false
VITE_USE_MOCK=true

# tsa-api 本地默认端口。
# ★ 不要在这里写 /tsa —— 各 api 模块与 mock 路由键已自带 `/tsa` 前缀
#   （由后端 Controller 的 ApiConstants.BASE_PATH 拥有，且后端无 context-path），
#   base 再带一次会拼成 /tsa/tsa/… 双前缀。
VITE_API_BASE_URL=http://localhost:8080
